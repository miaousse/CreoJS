const session = pfcGetCurrentSession();
const currentModel = session.CurrentModel;

function retrieveModsTableData() {
    if (!currentModel) {
        Browser.alert('aucun model actif');
        return;
    }
    if (currentModel.Type !== pfcModelType.MDL_DRAWING) {
        Browser.alert('le model actuel doit être un dessin');
        return;
    }

    const tables = currentModel.ListTables();

    const modelRev = GetActiveModelRevision(currentModel, CONSTANTS);
    const drawer = GetTrigram(GetParamValue(currentModel, CONSTANTS.PARAM_DRAWER) ?? '');
    //print(`${modelRev} dessiné par ${drawer}`);
    let modsTable;
    tables.forEach(table => {
        // filter: exact column count
        if (table.GetColumnCount() !== CONSTANTS.COLUMN_COUNT) return;

        // filter: first cell must exactly equal one of the markers (use FULL_TEXT or NORMAL_TEXT per your choice)
        const firstCellArr = table.GetText(pfcTableCell.Create(1, 1), CONSTANTS.NORMAL_TEXT);
        const firstCell = (firstCellArr && firstCellArr[0]) ? firstCellArr[0] : '';
        if (firstCell === CONSTANTS.MOD_TABLE_IND || firstCell === CONSTANTS.MOD_TABLE_MOD) {
            try {
                modsTable = processTable(table, CONSTANTS); // now only called for matching tables
            } catch (e) {
                Browser.alert(`error processing table: ${e}`);
            }
        }
    });
    //Browser.alert(modsTable ? `Table found with ${modsTable.length} entries` : 'No matching table found');
    const result = ensureNewRevision(modsTable, modelRev, drawer);
    session.RunMacro('~ Command `ProCmdDwgTblRegUpd`');
    // modsTable.push(result.newRow);
    return modsTable;

}


/* -------- helpers -------- */
function processTable(table, CONSTANTS) {
    const ROW_COUNT = table.GetRowCount();
    const COLUMN_COUNT = table.GetColumnCount();

    const firstCellContent = table.GetText(pfcTableCell.Create(1, 1), CONSTANTS.NORMAL_TEXT)[0] || '';
    if (!firstCellContent.includes(CONSTANTS.MOD_TABLE_IND) && !firstCellContent.includes(CONSTANTS.MOD_TABLE_MOD)) {
        return null;
    }

    const isLeftToRight = firstCellContent.includes(CONSTANTS.MOD_TABLE_IND);
    const columnOrder = isLeftToRight ? [1, 2, 3, 4, 5] : [5, 4, 3, 2, 1];
    const topArray = [];

    for (let row = 2; row <= ROW_COUNT; row++) {
        const tableLine = {
            ind: '',
            mod: '',
            ver: '',
            date: '',
            desc: ''
        };

        columnOrder.forEach((col, idx) => {
            if (col > COLUMN_COUNT) return;

            // On récupère la valeur. Si c'est vide ou nul, on met une chaîne vide.
            const val = table.GetText(pfcTableCell.Create(row, col), CONSTANTS.NORMAL_TEXT) || "";
            const cleanVal = String(val).trim();

            switch (idx) {
                case 0:
                    tableLine.ind = cleanVal;
                    break;
                case 1:
                    tableLine.mod = cleanVal;
                    break;
                case 2:
                    tableLine.ver = cleanVal;
                    break;
                case 3:
                    tableLine.date = cleanVal;
                    break;
                case 4:
                    tableLine.desc = cleanVal;
                    break;
            }
        });
        topArray.push(tableLine);
    }
    return topArray;
}


